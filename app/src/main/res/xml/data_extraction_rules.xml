<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude per-device auth tokens and session prefs from Google Cloud Backup -->
        <exclude domain="sharedpref" path="kinetra_device_auth_session.xml" />
        <exclude domain="sharedpref" path="kinetra_user_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude per-device auth tokens from phone-to-phone cable/Wi-Fi migration -->
        <exclude domain="sharedpref" path="kinetra_device_auth_session.xml" />
        <exclude domain="sharedpref" path="kinetra_user_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
