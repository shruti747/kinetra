<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.Kinetra" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kinetra_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Official AndroidX SplashScreen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Matte black #0A0A0A KINETRA splash background -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Centered deep maroon geometric K emblem -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_kinetra_splash_logo</item>
        <!-- Post-splash theme -->
        <item name="postSplashScreenTheme">@style/Theme.Kinetra</item>
    </style>
</resources>
